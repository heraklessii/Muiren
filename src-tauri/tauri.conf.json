{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muiren",
  "version": "0.2.0",
  "identifier": "com.mui.muiren",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "heraklessii",
    "copyright": "2026 Mui",
    "shortDescription": "Cok sekmede az RAM harcayan tarayici",
    "longDescription": "Onlarca sekme acik kalirken oyunun ya da videonun payina dusen bellegi geri veren masaustu tarayici. Bosta duran sekmeler uyutuluyor ve atiliyor; sekme cubugundaki yerleri, basliklari ve adresleri duruyor, tiklandiginda geri geliyorlar.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
